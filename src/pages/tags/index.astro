---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// Collect all unique tags and count posts per tag
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.keys(tagCounts).sort();
---

<BaseLayout 
  title="All Tags | Nimbus Cloudworks Engineering"
  description="Explore technical articles, guides, and engineering logs from Nimbus Cloudworks by topic."
>
  <div class="article-container">
    <header class="tags-header">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Back to all dispatches
        </a>
      </nav>

      <div class="hero-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
          <path d="M7 7h.01"></path>
        </svg>
        Topics & Categorization
      </div>
      <h1 class="hero-title" style="font-size: 2.4rem;">Browse by Tag</h1>
      <p class="hero-description">
        Explore targeted engineering deep dives grouped by domain, tooling, and operational focus.
      </p>
    </header>

    <div class="tag-cloud">
      {sortedTags.map((tag) => (
        <a href={`/tags/${tag}`} class="tag-cloud-item">
          <span>#{tag}</span>
          <span class="tag-count">{tagCounts[tag]}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
