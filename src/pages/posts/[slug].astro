---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, author, tags } = post.data;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(pubDate);

// Estimate reading time
const words = (post.body || description).split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(words / 200));
---

<BaseLayout 
  title={title} 
  description={description} 
  articleDate={pubDate.toISOString()}
>
  <article class="article-container">
    <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to all dispatches
      </a>
    </nav>

    <header class="article-header">
      <div class="article-meta">
        <time datetime={pubDate.toISOString()} class="article-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
            <line x1="16" x2="16" y1="2" y2="6"/>
            <line x1="8" x2="8" y1="2" y2="6"/>
            <line x1="3" x2="21" y1="10" y2="10"/>
          </svg>
          {formattedDate}
        </time>

        <span class="post-card-dot">•</span>

        <span class="article-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          {author}
        </span>

        <span class="post-card-dot">•</span>

        <span class="article-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          {readTime} min read
        </span>
      </div>

      <h1 class="article-title">{title}</h1>

      <p style="font-size: 1.2rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
        {description}
      </p>

      <div class="tag-list">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag-pill">
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <div class="article-content">
      <Content />
    </div>

    <div style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="/" class="back-link" style="margin-bottom: 0;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        All Articles
      </a>

      <div style="display: flex; gap: 0.5rem;">
        <a href="/rss.xml" class="nav-rss-btn" target="_blank" rel="noopener noreferrer">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          Follow via RSS
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
