---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 - Page Not Found | Nimbus Cloudworks" 
  description="The page you are looking for does not exist on Nimbus Cloudworks Engineering Blog."
>
  <div class="article-container" style="text-align: center; padding: 4rem 0;">
    <div class="hero-pill" style="margin: 0 auto 1.5rem;">
      HTTP 404
    </div>
    <h1 class="hero-title" style="font-size: 3rem; margin-bottom: 1rem;">
      Dispatch Not Found
    </h1>
    <p class="hero-description" style="margin: 0 auto 2rem;">
      The URL you requested could not be located. It might have been moved, renamed, or never existed in this branch.
    </p>
    <div>
      <a href="/" class="read-more-link" style="font-size: 1.1rem; justify-content: center;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Return to Home Page
      </a>
    </div>
  </div>
</BaseLayout>
