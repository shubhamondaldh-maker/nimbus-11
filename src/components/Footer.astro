---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand-link" style="margin-bottom: 0.5rem;">
          <div class="brand-logo-icon" style="width: 26px; height: 26px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            </svg>
          </div>
          <span style="font-size: 1.05rem;">Nimbus Cloudworks</span>
        </div>
        <p class="footer-brand-desc">
          Engineering insights, infrastructure deep-dives, and production playbooks from the distributed systems team at Nimbus Cloudworks.
        </p>
      </div>

      <div>
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/">All Articles</a></li>
          <li><a href="/tags">Explore Tags</a></li>
          <li><a href="/about">About Nimbus</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
          <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer-heading">Topics</h4>
        <ul class="footer-links">
          <li><a href="/tags/ci">Continuous Integration</a></li>
          <li><a href="/tags/devops">DevOps & Tooling</a></li>
          <li><a href="/tags/postgres">Postgres & Databases</a></li>
          <li><a href="/tags/incident-response">Incident Management</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        &copy; {currentYear} Nimbus Cloudworks Inc. All rights reserved.
      </div>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" style="color: var(--accent-cyan); text-decoration: underline;">Astro</a></span>
        <span>•</span>
        <span>Zero-JS by default</span>
      </div>
    </div>
  </div>
</footer>
